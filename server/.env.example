# ==============================================================================
# ASASU / DENISH BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port
PORT=3000

# MongoDB Database Connection String
MONGODB_URI=mongodb://localhost:27017/denish

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Clerk Authentication (Optional)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Geoapify Routing API Key for Driver Road Distance & Navigation Calculations
# Get your API key from: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Flutterwave Payment Gateway (Optional)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxx
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx

# SMTP / Email Service (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=support@denishng.com
